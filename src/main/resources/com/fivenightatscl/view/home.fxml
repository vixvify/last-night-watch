<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane
        fx:id="rootPane"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.fivenightatscl.controller.HomeController"
        stylesheets="@../css/home.css"
        prefWidth="1280"
        prefHeight="720"
        styleClass="root-pane">

    <ImageView
        fx:id="backgroundImage"
        preserveRatio="false"
        smooth="true"
        AnchorPane.topAnchor="0"
        AnchorPane.bottomAnchor="0"
        AnchorPane.leftAnchor="0"
        AnchorPane.rightAnchor="0"/>

    <Pane
            mouseTransparent="true"
            styleClass="dark-overlay"
            AnchorPane.topAnchor="0"
            AnchorPane.bottomAnchor="0"
            AnchorPane.leftAnchor="0"
            AnchorPane.rightAnchor="0"/>

    <Pane
            fx:id="redGlow"
            mouseTransparent="true"
            styleClass="red-glow"
            AnchorPane.topAnchor="0"
            AnchorPane.bottomAnchor="0"
            AnchorPane.leftAnchor="0"
            AnchorPane.rightAnchor="0"/>

    <VBox
            mouseTransparent="true"
            spacing="5"
            opacity="0.12"
            AnchorPane.topAnchor="0"
            AnchorPane.bottomAnchor="0"
            AnchorPane.leftAnchor="0"
            AnchorPane.rightAnchor="0">

        <Rectangle width="1280" height="2" styleClass="scan-line"/>
        <Rectangle width="1280" height="2" styleClass="scan-line"/>
        <Rectangle width="1280" height="2" styleClass="scan-line"/>
        <Rectangle width="1280" height="2" styleClass="scan-line"/>
        <Rectangle width="1280" height="2" styleClass="scan-line"/>
        <Rectangle width="1280" height="2" styleClass="scan-line"/>
        <Rectangle width="1280" height="2" styleClass="scan-line"/>
        <Rectangle width="1280" height="2" styleClass="scan-line"/>
        <Rectangle width="1280" height="2" styleClass="scan-line"/>
        <Rectangle width="1280" height="2" styleClass="scan-line"/>
        <Rectangle width="1280" height="2" styleClass="scan-line"/>
        <Rectangle width="1280" height="2" styleClass="scan-line"/>
    </VBox>

    <VBox
            layoutX="45"
            layoutY="35"
            spacing="3">

        <Label
                text="● REC"
                styleClass="recording"/>

        <Label
                text="CAM 01 // SCL MAIN HALL"
                styleClass="camera-text"/>

    </VBox>
    <VBox
            layoutX="90"
            layoutY="155"
            spacing="0">

        <Label
                text="FIVE"
                styleClass="title"/>

        <Label
                text="NIGHT"
                styleClass="title"/>

        <Label
                text="AT"
                styleClass="title-small"/>

        <Label
                text="SCL"
                styleClass="title-scl"/>

        <VBox
                spacing="2"
                style="-fx-padding: 40 0 0 0;">

            <Button
                    text=">  NEW GAME"
                    onAction="#handleNewGame"
                    styleClass="menu-button"/>

            <Button
                    text="   CONTINUE"
                    onAction="#handleContinue"
                    styleClass="menu-button"/>

            <Button
                    text="   HOW TO PLAY"
                    onAction="#handleHowToPlay"
                    styleClass="menu-button"/>

            <Button
                    text="   EXIT"
                    onAction="#handleExit"
                    styleClass="menu-button"/>

        </VBox>

    </VBox>

    <Label
            text="12:00 AM"
            styleClass="clock"
            AnchorPane.rightAnchor="35"
            AnchorPane.topAnchor="30"/>

    <Label
            text="SIGNAL: UNSTABLE"
            styleClass="signal"
            AnchorPane.rightAnchor="35"
            AnchorPane.topAnchor="65"/>

    <Label
            text="© SCL SECURITY SYSTEM // v0.1"
            styleClass="footer"
            AnchorPane.rightAnchor="25"
            AnchorPane.bottomAnchor="20"/>

</AnchorPane>